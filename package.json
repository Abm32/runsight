{
  "name": "runsight",
  "version": "1.3.2",
  "description": "Your project demos itself. One command runs your web app, explores it in a browser and produces an edited demo video. Free heuristic mode, or directed by your AI agent (MCP) or any model.",
  "main": "index.js",
  "bin": {
    "runsight": "cli.js"
  },
  "files": [
    "agent",
    "strategies",
    "utils",
    "config",
    "scripts",
    "skills",
    "docs/*.md",
    "index.js",
    "cli.js",
    "mcp.js"
  ],
  "scripts": {
    "start": "node cli.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "demo",
    "demo-video",
    "product-demo",
    "screen-recording",
    "mcp",
    "agent",
    "automation",
    "playwright",
    "screenshot",
    "video",
    "explorer",
    "devtool",
    "ai",
    "proof"
  ],
  "author": "Abm32",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abm32/runsight"
  },
  "homepage": "https://www.npmjs.com/package/runsight",
  "bugs": {
    "url": "https://github.com/Abm32/runsight/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "openai": "4.77.0",
    "playwright": "1.49.1",
    "yargs": "17.7.2"
  }
}
